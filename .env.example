# Copy to .env (or export in your shell). All optional.

# Needed only if you pick the OpenAI provider, or want model-based tool
# selection in the Analyze tab. Ollama needs no key.
OPENAI_API_KEY=

# Where the database, mail tokens and credentials live. Default: ~/.email-agent
EMAIL_AGENT_DATA_DIR=

# Outlook / Microsoft 365. The Application (client) ID of an Entra app
# registration with public client flows enabled; see docs/outlook-setup.md.
# Tenant is "common" unless your school registered the app for you.
EMAIL_AGENT_OUTLOOK_CLIENT_ID=
EMAIL_AGENT_OUTLOOK_TENANT=common

# Web UI bind address. Keep it on localhost.
EMAIL_AGENT_HOST=127.0.0.1
EMAIL_AGENT_PORT=8000
EMAIL_AGENT_LOG_LEVEL=INFO
